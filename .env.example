# 复制为 .env 后按需修改；.env 不要提交到版本库。
TZ=Asia/Shanghai

# MySQL 8.0（若 3306 被占用，改为 3308；镜像标签不可用时改为 mysql:8.0）
MYSQL_IMAGE=mysql:8.0.46
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=yunshu
MYSQL_USER=yunshu_app
MYSQL_PASSWORD=change-me-app

# Redis（P0 未使用，P1 预留；仅 --profile p1 启动；标签不可用时改为 redis:7-alpine）
REDIS_IMAGE=redis:7.4-alpine
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis

# MinIO（开发环境对象存储；生产使用阿里云 OSS；固定 release 标签）
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=yunshu_minio
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=yunshu

# ---- 后端认证密钥（生产必须替换为强随机值；.env 不提交版本库）----
JWT_C_SECRET=change-me-jwt-c-side-secret-0123456789abcdef
JWT_ADMIN_SECRET=change-me-jwt-admin-secret-0123456789abcdef
# 手机号 AES-GCM 与 HMAC-SHA256 密钥（Base64 的 32 字节）；openssl rand -base64 32 生成
PHONE_AES_KEY=change-me-phone-aes-key-base64-32-bytes
PHONE_HMAC_KEY=change-me-phone-hmac-key-base64-32-bytes
